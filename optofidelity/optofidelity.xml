<optofidelity>
  <benchmark-system>
    <backend type="tnt" host="192.168.0.11" port="8000" />
    <camera type="phantom" host="192.168.0.4" />
    <finger-calibration down-delay="-4" up-delay="4" />
    <led-calibration-subject backend-name="calibration" />
  </benchmark-system>

  <orchestrator results="gs://touchbot/optofidelity/benchmark_results"
                database="filecontents:results_database.url" />

  <subject-type type-name="base">
    <benchmark name="tap" type="tap" activity="tap" />
    <benchmark name="scroll" type="line_draw" activity="scroll" />
    <benchmark name="touch_move" type="line_draw" activity="touch_move" />
  </subject-type>

  <subject-type type-name="clank_beta" parent-type="base">
    <navigator type="web_adb" component="com.chrome.beta/com.google.android.apps.chrome.Main">
      <activity name="calibration" file="file:html/flash.html" />
      <activity name="scroll" file="file:html/scroll.html" />
      <activity name="touch_move" file="file:html/move.html" />
      <activity name="tap" file="file:html/tap.html" />
      <resource file="file:html/jquery.min.js" />
    </navigator>
    <updater type="chrome" channel="beta" />
    <dashboard type="chromeperf" endpoint="https://chromeperf.appspot.com/add_point" />
  </subject-type>

  <subject-type type-name="android_native" margin="(10, 15)" parent-type="base">
    <navigator type="native_adb" package="org.chromium.touchlatency" apk="file:apks/touchlatency.apk">
      <activity name="calibration" intent="FlashActivity" />
      <activity name="scroll" intent="ScrollActivity" />
      <activity name="tap" intent="TapActivity" />
    </navigator>
    <updater type="manual" version="0.0" />
  </subject-type>

  <dut-type type-name="nexus_phone">
    <subject name="clank_beta" type="clank_beta" margin="(20, 15)" />
    <subject name="native" type="android_native" />
  </dut-type>

  <dut-type type-name="nexus_tablet" parent-type="nexus_phone">
    <subject name="clank_beta" margin="(30, 15)" />
  </dut-type>

  <dut name="nexus4" adb="04f6cafb8c976e5a" type="nexus_phone" />
  <dut name="nexus5" adb="08a9896c255d540b" type="nexus_phone" />
  <dut name="nexus6" adb="NP5A340401" type="nexus_phone" />
  <dut name="nexus7" adb="071c76bf" type="nexus_tablet" />
  <dut name="nexus9" adb="HT4AEJT02069" type="nexus_tablet" />

</optofidelity>